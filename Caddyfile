# Caddy in front of `keel serve`. TLS, a reverse proxy, and an access log.
#
# WHAT THIS FILE IS FOR. The image serves plain HTTP on 3000 and holds no
# certificate machinery, which is correct: a distroless binary that reads
# Postgres has no business managing ACME accounts. Caddy terminates TLS,
# redirects HTTP, and proxies. It makes no decision about the API.
#
# PREPARED, NOT APPLIED. This file is Claude's half. The host, its DNS and its
# certificates are Al's, the same PREPARE and APPLY split
# .github/workflows/deploy.yml and scripts/s3-archive/ are built on. The runbook
# is scripts/deploy/RUNBOOK.md.
#
# ---------------------------------------------------------------------------
# ONE HOSTNAME, AND THE APEX IS DELIBERATELY NOT IT.
#
# This box serves api.keels.app and nothing else. The landing page and the
# dashboard at keels.app and www.keels.app are a different application, in a
# different repository, already deployed on VERCEL. Their DNS points at Vercel,
# not here.
#
# THAT IS NOT A TIDINESS ARGUMENT, IT IS A STARTUP FAILURE. Caddy requests a
# certificate for every hostname in this file the moment it loads. An ACME
# challenge for a name whose DNS answers with Vercel's address cannot be solved:
# the CA connects to the address the world sees, which is not this host, and the
# challenge fails. Caddy then retries with backoff, and the site that DOES
# resolve here is degraded or down while it does. So adding `keels.app` to this
# file, or a `redir` block for it, or a `www.keels.app` alias "just in case",
# does not add a redirect nobody uses. It takes the API down.
#
# There is therefore no apex block, no www block and no catch-all below. A
# request arriving here for any other hostname gets no certificate and no
# response, which is the correct answer from a host that does not serve it.
#
# If the apex ever should point here, that is a DNS change away from Vercel
# first and a change to this file second, in that order, and it is Al's call
# rather than an edit.
# ---------------------------------------------------------------------------
{
	# The hostname is configuration, not a literal. The documented value is
	# api.keels.app and it lives in the host's .env file and in RUNBOOK.md
	# section 2, so this file is the same on a staging box.
	#
	# THERE IS NO DEFAULT ON PURPOSE. With KEEL_DOMAIN unset this file will not
	# parse and Caddy will not start, which is a loud failure in the one place
	# somebody is already watching. A default of api.keels.app would hardcode
	# the production domain into a file that is meant not to name it; a default
	# of localhost would be worse, because the box would come up, serve nothing
	# the internet can reach, and never say why.
	#
	# THE ERROR YOU GET IS MISLEADING, so it is written down here rather than
	# rediscovered at three in the morning. An unset KEEL_DOMAIN leaves the site
	# block below with no address, an addressless block is how a Caddyfile
	# spells "global options", and there is already one of those. So Caddy says:
	#
	#   Error: adapting config using caddyfile: server block without any key is
	#   global configuration, and if used, it must be first
	#
	# It is not complaining about the order of the blocks. It is telling you
	# KEEL_DOMAIN is empty.
	#
	# admin off: the local admin API is a config-reload socket. Nothing here
	# reloads Caddy through it, and the deploy path is `docker compose up -d`.
	admin off

	# An ACME account email is optional and buys expiry warnings from Let's
	# Encrypt. To use it, uncomment the directive and set KEEL_ACME_EMAIL in the
	# host's .env beside KEEL_DOMAIN:
	#
	#   email {$KEEL_ACME_EMAIL}
	#
	# It is commented out rather than left in with an empty default because an
	# empty email argument is itself a parse error, so the form that "works when
	# unset" does not exist. Leaving it out entirely is supported: Caddy
	# registers an ACME account without one.
}

{$KEEL_DOMAIN} {
	# `keel-serve` is the compose service name, which is the network alias
	# Docker resolves; 3000 is the container port and it is never published to
	# the host, so this proxy is the only route in. Renaming that service means
	# editing this line in the same commit.
	reverse_proxy keel-serve:3000 {
		# 65 seconds, just past the API's own 60 second WriteTimeout in
		# internal/api's Serve. A proxy that gives up first turns the server's
		# own timeout into a 504 from Caddy and loses the reason.
		transport http {
			response_header_timeout 65s
		}
	}

	# ---------------------------------------------------------------------
	# NOTHING HERE ADDS A CORS HEADER, AND THAT IS A RULE RATHER THAN AN
	# OMISSION.
	#
	# CORS is handled inside internal/api, by work item A2. That package holds
	# the allowlist, reads it from KEEL_CORS_ORIGINS, echoes back the request
	# origin only on an exact match, answers preflight with 204, and sends
	# Vary: Origin on every response including the ones it refuses.
	#
	# TWO SOURCES OF CORS HEADERS IS A BUG WAITING TO HAPPEN, and it is worse
	# than a duplicated setting. A `header` directive here that also set
	# Access-Control-Allow-Origin would send the header TWICE, and two
	# Access-Control-Allow-Origin headers is not a lenient case a browser picks
	# from: it is a hard CORS failure, so the dashboard would break in exactly
	# the situation both layers were trying to serve. It would also split the
	# allowlist across a Go file and a Caddyfile, so narrowing it later would
	# mean finding both.
	#
	# Same for a `method` filter or anything that answers OPTIONS here: the API
	# answers preflight itself with a 204, and the preflight has to reach it.
	# ---------------------------------------------------------------------

	encode zstd gzip

	header {
		# HSTS FOR THIS HOSTNAME ONLY. No includeSubdomains and no preload,
		# which is the whole point: both of those reach past api.keels.app and
		# bind keels.app, www.keels.app and every future subdomain to HTTPS.
		# Those are served by Vercel and are not this box's to make promises
		# for. Preload is worse again, because it is a submission to a list that
		# is slow to leave.
		Strict-Transport-Security "max-age=31536000"

		X-Content-Type-Options "nosniff"

		# The API serves JSON and never HTML, so there is no document for a
		# frame to hold and nothing for a script to load.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"

		# Not a secret, and not a security measure either. It is one less line
		# of noise in a response a consumer reads by hand.
		-Server
	}

	# ACCESS LOGGING TO A FILE, rolled by Caddy itself rather than by anything on
	# the host. The file lives on the caddy_logs volume, so it survives the
	# container being recreated by a deploy, which is when you most want to read
	# what happened just before.
	#
	# THE ROLL SETTINGS ARE A DISK BUDGET AND NOT A RETENTION POLICY. 10 MiB
	# times 5 files caps this at about 50 MiB, on a small VPS whose disk also
	# holds Postgres and the database dumps. An access log that fills the disk
	# takes down the database, which is a far worse outcome than losing last
	# week's requests. Nothing here is evidence the deliverable keeps: the
	# archive that is meant to last is recordings/samples/, in git.
	#
	# JSON rather than the console format, so `docker compose exec caddy` plus
	# `jq` can answer a question without a regex. RUNBOOK.md section 8 has the
	# commands.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 336h
		}
		format json
	}
}
