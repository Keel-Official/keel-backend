# Placeholders, none of them work. `cp env.example .env && chmod 600 .env`
# scripts/deploy/RUNBOOK.md section 3.4 is the authority on the values.
# Not named .env.example because .gitignore swallows .env.* and it would not
# reach a clone. Read only by `docker compose`, from the project directory.

# The commit SHA to run. Never `latest`; the deploy job rewrites this line.
KEEL_IMAGE_TAG=REPLACE_WITH_A_COMMIT_SHA

# The Postgres already on this host. Secret: it carries a password.
# host.docker.internal is the host as seen from a container. `localhost` is the
# container itself, `postgres` is the removed service, and 5433 is a
# docker-compose.yml port. All three fail as a 502 with nothing in it. Section 9.
KEEL_DSN=postgres://keel:REPLACE_WITH_THE_DB_PASSWORD@host.docker.internal:5432/keel?sslmode=disable

# The hostname Caddy serves and gets a certificate for. Section 2.
KEEL_DOMAIN=api.keels.app

# The DASHBOARD's origins, not this API's own. Exact, comma separated, no
# wildcard. Add http://localhost:5173 and http://127.0.0.1:5173 for a dev
# server. Read once at startup, so changing it needs `up -d keel-serve`.
KEEL_CORS_ORIGINS=https://keels.app,https://www.keels.app

# Optional.
#KEEL_IMAGE=ghcr.io/keel-official/keel-backend
#KEEL_ACME_EMAIL=you@example.org
#KEEL_DUMP_KEEP_DAYS=14

# NOT variables here, because compose does not run them. Both take the HOST's
# spelling of the DSN, localhost and not host.docker.internal, and both need a
# client on the host at least as new as the server.
#
#   KEEL_MIGRATE_DSN='postgres://keel:PASSWORD@localhost:5432/keel' bash scripts/migrate.sh
#   KEEL_DUMP_DSN='postgres://keel:PASSWORD@localhost:5432/keel' bash scripts/deploy/dump-database.sh
